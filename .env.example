# ─────────────────────────────────────────────────────────────
# JornIA — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores reais.
# ─────────────────────────────────────────────────────────────

# ── Banco de dados (PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://jornia:jornia@localhost:5432/jornia?schema=public"
# Conexão direta (sem pooler), usada só por `prisma migrate`/`db push`.
# Num Postgres comum, sem pooler (ex.: local), use o MESMO valor de DATABASE_URL.
# Na Neon, DATABASE_URL é a connection string "Pooled" e DIRECT_URL é a "Direct"
# (as duas aparecem no painel da Neon, aba Connect).
DIRECT_URL="postgresql://jornia:jornia@localhost:5432/jornia?schema=public"

# ── Autenticação ─────────────────────────────────────────────
# Segredo usado para assinar os JWT de sessão. Gere um valor forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-por-um-segredo-forte-e-aleatorio"
# Duração da sessão (em segundos). Padrão: 7 dias.
AUTH_SESSION_TTL="604800"
# Autentica o Vercel Cron em /api/cron/* (o Vercel envia esse valor sozinho
# como "Authorization: Bearer ..." nos crons — sem isso o endpoint fica
# aberto pra qualquer um). Gere com o mesmo comando do AUTH_SECRET.
CRON_SECRET=""

# ── Provedor de IA (texto) ───────────────────────────────────
# Provider: "chain" | "mock" | "groq" | "gemini" | "nvidia" | "openrouter" |
#           "openai" | "anthropic"
#   chain      -> corrente com fallback: tenta Groq, depois OpenRouter (cada
#                 modelo da lista, em ordem); se um provedor cair/der rate
#                 limit, passa pro próximo automaticamente — RECOMENDADO
#                 assim que tiver 2+ chaves gratuitas configuradas.
#   mock       -> roda o fluxo sem nenhuma chave (dev)
#   groq       -> free tier estável, rápido, compatível com OpenAI
#   gemini     -> Google AI Studio, cota grátis generosa
#   nvidia     -> NIM (integrate.api.nvidia.com) — verifique quais modelos
#                 sua chave realmente tem habilitados antes de usar (o
#                 catálogo público lista muitos que retornam 404 por conta)
#   openrouter -> gateway compatível com OpenAI (tem modelos ":free")
#   openai     -> API oficial da OpenAI
#   anthropic  -> API da Anthropic (Claude)
AI_PROVIDER="mock"
# ID do modelo NO PROVIDER escolhido (usado nos modos de provider único —
# em modo "chain" use as variáveis *_MODEL/*_MODELS específicas abaixo):
#   groq       -> ex.: openai/gpt-oss-20b     (veja console.groq.com/docs/models)
#   gemini     -> ex.: gemini-2.0-flash
#   openrouter -> ex.: nex-agi/nex-n2.5-mini:free (veja openrouter.ai/models, filtro $0)
#   openai     -> ex.: gpt-4o-mini
#   anthropic  -> ex.: claude-sonnet-5
AI_MODEL="openai/gpt-oss-20b"

# Preencha as chaves dos providers que for usar:
# GROQ_API_KEY="gsk_..."             # https://console.groq.com/keys
# GROQ_MODEL="openai/gpt-oss-20b"    # opcional, usado em modo "chain"

# OPENROUTER_API_KEY="sk-or-..."     # https://openrouter.ai/keys
# Modelos tentados em ordem em modo "chain" (vírgula-separados):
# OPENROUTER_MODELS="nex-agi/nex-n2.5-mini:free,nex-agi/nex-n2.5-pro:free,inclusionai/ling-3.0-flash-vl:free"

# NVIDIA_API_KEY="nvapi-..."         # https://build.nvidia.com
# NVIDIA_MODEL=""                    # só entra na corrente se você definir isso

# GEMINI_API_KEY="..."               # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY="sk-ant-..."     # https://console.anthropic.com
# OPENAI_API_KEY="sk-..."            # https://platform.openai.com/api-keys
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ── Storage de mídia ─────────────────────────────────────────
# Provider: "local" (padrão, salva em ./public/uploads) | "s3"
STORAGE_PROVIDER="local"
# Base pública usada para montar URLs no modo local:
PUBLIC_BASE_URL="http://localhost:3000"

# --- S3 / R2 / Supabase Storage (só se STORAGE_PROVIDER=s3) ---
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="jornia"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.seu-dominio.com"   # base pública do bucket
# S3_FORCE_PATH_STYLE="true"

# ── Instagram Graph API (Meta) ───────────────────────────────
# Conta Instagram Business/Creator vinculada a uma Página do Facebook.
IG_USER_ID=""
IG_ACCESS_TOKEN=""
# Versão da Graph API:
IG_GRAPH_VERSION="v21.0"

# ── E-mail (Resend) ───────────────────────────────────────────
# Usado só por admin/manager pra resetar senha de alguém e mandar o login
# novo por e-mail (Admin → Usuários → "Enviar login"). Pegue a chave em
# https://resend.com/api-keys
RESEND_API_KEY=""
# "onboarding@resend.dev" só entrega pro próprio dono da conta Resend
# (modo sandbox/teste). Pra mandar pra qualquer usuário de verdade, verifique
# um domínio seu no Resend e troque para algo como "JornIA <login@seudominio.com>".
EMAIL_FROM="JornIA <onboarding@resend.dev>"
