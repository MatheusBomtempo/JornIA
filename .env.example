# ─────────────────────────────────────────────────────────────
# JornIA — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores reais.
# ─────────────────────────────────────────────────────────────

# ── Banco de dados (PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://jornia:jornia@localhost:5432/jornia?schema=public"

# ── Autenticação ─────────────────────────────────────────────
# Segredo usado para assinar os JWT de sessão. Gere um valor forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="troque-por-um-segredo-forte-e-aleatorio"
# Duração da sessão (em segundos). Padrão: 7 dias.
AUTH_SESSION_TTL="604800"

# ── Provedor de IA (texto) ───────────────────────────────────
# Provider: "anthropic" (padrão) | "openai" | "mock"
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."   # só se AI_PROVIDER=openai

# ── Storage de mídia ─────────────────────────────────────────
# Provider: "local" (padrão, salva em ./public/uploads) | "s3"
STORAGE_PROVIDER="local"
# Base pública usada para montar URLs no modo local:
PUBLIC_BASE_URL="http://localhost:3000"

# --- S3 / R2 / Supabase Storage (só se STORAGE_PROVIDER=s3) ---
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="jornia"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.seu-dominio.com"   # base pública do bucket
# S3_FORCE_PATH_STYLE="true"

# ── Instagram Graph API (Meta) ───────────────────────────────
# Conta Instagram Business/Creator vinculada a uma Página do Facebook.
IG_USER_ID=""
IG_ACCESS_TOKEN=""
# Versão da Graph API:
IG_GRAPH_VERSION="v21.0"
