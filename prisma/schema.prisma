// JornIA — schema do banco (PostgreSQL)
// Mapeado 1:1 do SPEC.md. Campos "status"/"origin"/"decision" ficam como String
// (validados no app via Zod) para bater exatamente com o SPEC; user_role é enum.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (pgbouncer) — usado em runtime
  directUrl = env("DIRECT_URL") // conexão direta — só usada por `prisma migrate`
}

enum UserRole {
  admin
  manager
  staff

  @@map("user_role")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(staff)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /** Última vez que um admin/manager resetou a senha e mandou por e-mail. */
  passwordResetAt DateTime? @map("password_reset_at") @db.Timestamptz(6)

  posts            Post[]
  apiKeysCreated   ApiKey[]
  reviewDecisions  ReviewDecision[]
  postVersions     PostVersion[]
  styleExamples    StyleExample[]
  styleReferences  StyleReference[] // legado

  @@map("users")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  keyHash    String    @map("key_hash")
  scopes     String[]
  createdBy  String?   @map("created_by") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  creator User? @relation(fields: [createdBy], references: [id])

  @@map("api_keys")
}

model Post {
  id             String   @id @default(uuid()) @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  region         String?
  sourceType     String   @map("source_type") // 'photo' | 'text' | 'link'
  sourceText     String?  @map("source_text")
  sourceUrl      String?  @map("source_url")
  scrapedContent String?  @map("scraped_content")
  /** Créditos/marcações: [{ type: 'photo'|'source'|..., handle: '@fulano' }] */
  credits        Json?
  status         String   @default("processing_ai")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  author   User          @relation(fields: [createdBy], references: [id])
  photos   PostPhoto[]
  versions PostVersion[]

  @@index([status])
  @@index([createdBy])
  @@map("posts")
}

model PostPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  storageUrl String   @map("storage_url") // foto original, sem edição
  orderIndex Int?     @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  selectedInVersions PostVersion[]

  @@map("post_photos")
}

model ArtTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  canvasWidth     Int      @default(1080) @map("canvas_width")
  canvasHeight    Int      @default(1080) @map("canvas_height") // ou 1350 pro formato 4:5
  overlayAssetUrl String   @map("overlay_asset_url")
  photoSlot       Json     @map("photo_slot") // { x, y, width, height }
  /** Slot do título da arte (máx. 69 caracteres). */
  titleSlot       Json     @map("text_slot")
  /** Slot do subtítulo, logo abaixo do título (máx. 149 caracteres). */
  subtitleSlot    Json?    @map("subtitle_slot")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  versions PostVersion[]

  @@map("art_templates")
}

/**
 * LEGADO — substituída por StyleExample. Mantida apenas para não destruir
 * dados existentes; nenhuma parte do app lê ou escreve nesta tabela.
 * Pode ser removida numa migração futura, quando você quiser.
 */
model StyleReference {
  id               Int      @id @default(1)
  exampleTitle     String?  @map("example_title")
  exampleShortNews String?  @map("example_short_news")
  exampleCaption   String?  @map("example_caption")
  exampleArtText   String?  @map("example_art_text")
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  editor User? @relation(fields: [updatedBy], references: [id])

  @@map("style_reference")
}

/**
 * Exemplos de referência de estilo. A IA imita o tom/formato destes posts
 * reais do jornal (não copia o conteúdo).
 */
model StyleExample {
  id         String   @id @default(uuid()) @db.Uuid
  title      String? // título da arte (máx. 69)
  subtitle   String? // subtítulo da arte (máx. 149)
  caption    String? // legenda completa do Instagram
  orderIndex Int      @default(0) @map("order_index")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  author User? @relation(fields: [createdBy], references: [id])

  @@map("style_examples")
}

model PostVersion {
  id               String   @id @default(uuid()) @db.Uuid
  postId           String   @map("post_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  origin           String // 'ai_generated' | 'manual_edit' | 'ai_regenerated'
  /** Título da arte (máx. 69 caracteres). */
  title            String?
  /** Subtítulo da arte, abaixo do título (máx. 149 caracteres). */
  subtitle         String?
  shortNews        String?  @map("short_news") // legado, não usado
  instagramCaption String?  @map("instagram_caption")
  artText          String?  @map("art_text") // legado, não usado
  /** Provedor que gerou o texto desta versão (ex.: "groq", "openrouter:..."). Nulo em edição manual. */
  aiProvider       String?  @map("ai_provider")
  /** Modelo usado pelo provedor acima (ex.: "openai/gpt-oss-20b"). */
  aiModel          String?  @map("ai_model")
  selectedPhotoId  String?  @map("selected_photo_id") @db.Uuid
  photoTransform   Json?    @map("photo_transform") // { offsetX, offsetY, scale }
  /** Deslocamento do título em relação à posição padrão do template. */
  titleOffset      Json?    @map("title_offset") // { offsetX, offsetY }
  /** Deslocamento do subtítulo em relação à posição padrão do template. */
  subtitleOffset   Json?    @map("subtitle_offset") // { offsetX, offsetY }
  artTemplateId    String?  @map("art_template_id") @db.Uuid
  renderedArtUrl   String?  @map("rendered_art_url")
  /** Exatamente 2 sugestões de busca de imagem geradas pela IA (ex.: ["viatura polícia MG", "arma sobre mesa"]). Auxiliar — nunca seleciona nem publica foto sozinha. */
  imageSuggestions Json?    @map("image_suggestions")
  editedBy         String?  @map("edited_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post          Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  selectedPhoto PostPhoto?       @relation(fields: [selectedPhotoId], references: [id])
  artTemplate   ArtTemplate?     @relation(fields: [artTemplateId], references: [id])
  editor        User?            @relation(fields: [editedBy], references: [id])
  decisions     ReviewDecision[]
  publications  Publication[]

  @@unique([postId, versionNumber])
  @@index([postId])
  @@map("post_versions")
}

model ReviewDecision {
  id            String   @id @default(uuid()) @db.Uuid
  postVersionId String   @map("post_version_id") @db.Uuid
  reviewerId    String   @map("reviewer_id") @db.Uuid
  decision      String // 'approved' | 'rejected' | 'regenerate' | 'manual_edit'
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  postVersion PostVersion @relation(fields: [postVersionId], references: [id])
  reviewer    User        @relation(fields: [reviewerId], references: [id])

  @@index([postVersionId])
  @@map("review_decisions")
}

model Publication {
  id               String    @id @default(uuid()) @db.Uuid
  postVersionId    String    @map("post_version_id") @db.Uuid
  instagramMediaId String?   @map("instagram_media_id")
  instagramPostUrl String?   @map("instagram_post_url")
  status           String // 'pending' | 'container_created' | 'published' | 'failed'
  errorMessage     String?   @map("error_message")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  postVersion PostVersion @relation(fields: [postVersionId], references: [id])

  @@index([postVersionId])
  @@map("publications")
}

/**
 * Rastro mínimo de auditoria: quando um post é apagado pela limpeza
 * automática de retenção (ver função `cleanup_expired_posts()` no banco),
 * o registro pesado (fotos, versões, decisões, publicações) some, mas fica
 * esta linha — só o essencial pra responder "quem postou o quê e quando" se
 * precisar auditar depois. Sem relation pro Post: ele já não existe mais.
 */
model PostAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @map("post_id") @db.Uuid
  title       String?
  /** Status do post no momento em que foi apagado ('published' | 'in_review' | 'failed'). */
  status      String
  authorName  String    @map("author_name")
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  purgedAt    DateTime  @default(now()) @map("purged_at") @db.Timestamptz(6)

  @@index([purgedAt])
  @@map("post_audit_log")
}
